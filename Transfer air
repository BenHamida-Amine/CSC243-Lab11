class ScubaTank:
    def __init__(self, label, bar):
        self.label = label
        self.bar = bar
        
    def get_bar(self):
        return self.bar
    
    def set_bar(self, bar):
        if  0 <= bar <= 300:
            self.bar = bar
        else:
            print('Invalid pressure')

    def fill(self, amount):
        if amount > 0:
           self.bar += amount
        else:
            print("Invalid amount")
        
    def release(self, amount):
        if amount > self.get_bar():
            print("Not enough air")
        elif amount <= 0:
            print("Invalid amount")
        else:
            self.bar -= amount
    
    def __str__(self):
        return f'Tank {self.label}:{self.bar} bar'



def transfer_air(source, target, amount):
    if amount > 0:
        prev = source.get_bar()    
        source.release(amount)
        if source.get_bar() < prev:
            
           target.fill(amount)
        
    else:
        print('Invalid amount')
