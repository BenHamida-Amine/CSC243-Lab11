class Point:
    def __init__(self,x,y):
        self.x = x
        self.y = y
    def __str__(self):
        return '(' + str(self.x) + "," + str(self.y) + ")"
    

class Rectangle:
    def __init__(self,p,q):
        
        if not (type(p) is Point and type(q) is Point) or p.x > q.x or p.y > p.y:
            return "Bad input"
        else:
            self.p = p
            self.q = q
    def __str__(self):
        return f"(p + ({self.p.x},{self.p.y}) , q = ({self.q.x},{self.q.y}))"
    
    def get_height(self):
        return self.q.y - self.p.y
    
    def get_width(self):
        return self.q.x - self.p.x
    
    def perimeter(self):
        return (self.get_height() + self.get_width()) * 2
    
    def area(self):
        return (self.get_height() * self.get_width())
    
    def contains(self, pt):
        
        if not (type(pt) is Point):
           return 'Bad Input'
        else:
           if self.p.x <= pt.x <= self.q.x and  self.p.y <= pt.y <= self.q.y:
              return True
           else:
              return False
